# AURA Command Center — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# NEVER share or print these values.
# Values are read at runtime by AURA — never stored in localStorage or source code.

# ─── Anthropic / Claude ───────────────────────────────────────────────────────
VITE_ANTHROPIC_API_KEY=

# ─── OpenAI / Codex ───────────────────────────────────────────────────────────
VITE_OPENAI_API_KEY=

# ─── Google / Gemini ──────────────────────────────────────────────────────────
VITE_GOOGLE_API_KEY=

# ─── ChatGPT Relay (clipboard-based, no API key needed) ──────────────────────
# Relay uses manual clipboard handoff — no key required.

# ─── Antigravity ──────────────────────────────────────────────────────────────
VITE_ANTIGRAVITY_API_KEY=

# ─── Oracle / OpenClaude (Concept — not yet available) ────────────────────────
# VITE_ORACLE_API_KEY=

# ─── Custom Provider ──────────────────────────────────────────────────────────
# VITE_CUSTOM_PROVIDER_API_KEY=
# VITE_CUSTOM_PROVIDER_BASE_URL=

# ─── App Config ───────────────────────────────────────────────────────────────
# VITE_APP_ENV=development
